# API. Use arquivos distintos por ambiente.
FN_ENVIRONMENT=local
FN_DATABASE_URL=
FN_SUPABASE_URL=http://127.0.0.1:54321
FN_SUPABASE_ISSUER=http://127.0.0.1:54321/auth/v1
FN_SUPABASE_PUBLISHABLE_KEY=
FN_SUPABASE_ADMIN_KEY=
FN_AUTH_MODE=remote
FN_FRONTEND_URL=http://127.0.0.1:8088
FN_CORS_ORIGINS='["http://127.0.0.1:8088"]'
FN_STATIC_DIR=
FN_OPENAPI_ENABLED=true
# Chave de 32 bytes em Base64 URL-safe para armazenamento dos certificados.
FN_FISCAL_MASTER_KEY=
# Objeto JSON privado com as integrações externas por empresa.
FN_EXTERNAL_INTEGRATIONS=
# Serviço WhatsApp interno (whatsapp/compose.yaml). Token igual ao PORTAL_SERVICE_TOKEN do serviço.
FN_WHATSAPP_SERVICE_URL=
FN_WHATSAPP_SERVICE_TOKEN=
# URL pública usada pelos bots dos clientes, ex.: https://api.futuranext.com.br/whatsapp
FN_WHATSAPP_PUBLIC_API_URL=
# Cobranças da FuturaNext. As chaves do Asaas ficam só no backend.
FN_ASAAS_ENVIRONMENT=sandbox
FN_ASAAS_API_KEY=
FN_ASAAS_WEBHOOK_TOKEN=
# Chat de IA do site (chave da OpenAI só no servidor; use aspas simples se tiver $)
FN_OPENAI_API_KEY=
FN_OPENAI_MODEL=gpt-4o-mini
FN_SITE_CHAT_DAILY_LIMIT=1500
FN_LEADS_EMAIL=suporte@futuranext.com.br

# E-mail de primeiro acesso via Zoho Mail API.
FN_ZOHO_MAIL_REGION=us
FN_ZOHO_MAIL_CLIENT_ID=
FN_ZOHO_MAIL_CLIENT_SECRET=
FN_ZOHO_MAIL_REFRESH_TOKEN=
FN_ZOHO_MAIL_ACCOUNT_ID=
FN_ZOHO_MAIL_SENDER=

# Administração do banco. Reserve estas variáveis ao processo de operação.
FN_MIGRATION_DATABASE_URL=
FN_APP_DB_PASSWORD=
# Senhas dos papéis do serviço WhatsApp (migração 0013): python -m app.db_admin setup-whatsapp-roles
WA_API_DB_PASSWORD=
WA_WORKER_DB_PASSWORD=

# Build estático. Somente valores públicos.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_API_BASE_URL=

# Compose. Use o digest da imagem homologada em deploys.
FN_API_IMAGE=futuranext-api:local
# FN_API_HOSTNAME=api.example.com
# FN_CADDY_CERT_DIR=/var/lib/futuranext/tls
