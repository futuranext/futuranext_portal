{
	admin off
	auto_https disable_redirects
}

{$FN_API_HOSTNAME} {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		max_size 1MB
	}
	reverse_proxy api:8080
}
