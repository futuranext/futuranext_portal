{
	admin off
	auto_https disable_redirects
}

{$FN_API_HOSTNAME} {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		max_size 1MB
	}

	# API de envio do WhatsApp para os bots dos clientes (chave wp_...). As rotas de serviço,
	# o ingresso da Evolution e o restante do backend WhatsApp ficam só na rede interna.
	@whatsapp path /whatsapp/api/v1/messages /whatsapp/api/v1/messages/* /whatsapp/api/v1/instances /whatsapp/api/v1/instances/*
	handle @whatsapp {
		uri strip_prefix /whatsapp
		reverse_proxy whatsapp-api:8000
	}
	handle {
		reverse_proxy api:8080
	}
}
