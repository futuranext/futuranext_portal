# Serviço WhatsApp (whatsapp/compose.yaml). Copie para /opt/futuranext/whatsapp/.env no Droplet,
# com permissão 600. Nunca versione o arquivo preenchido. Guia: docs/WHATSAPP_PUBLICACAO.md.

# Imagem construída a partir do commit homologado, ex.: futuranext-whatsapp:3f2c1ab
WA_IMAGE=

# PostgreSQL do Supabase do portal (Session pooler, porta 5432, TLS com verificação da CA).
# Papéis criados pela migração 0013 e ativados por `python -m app.db_admin setup-whatsapp-roles`.
# Use aspas simples: a URL contém "&".
WA_API_DATABASE_URL='postgresql://wa_api.REF:SENHA@HOST_POOLER:5432/postgres?sslmode=verify-full&sslrootcert=/run/futuranext/supabase-ca.crt'
WA_WORKER_DATABASE_URL='postgresql://wa_worker.REF:SENHA@HOST_POOLER:5432/postgres?sslmode=verify-full&sslrootcert=/run/futuranext/supabase-ca.crt'
# As mesmas senhas usadas acima, lidas pelo setup-whatsapp-roles (24 caracteres ou mais).
WA_API_DB_PASSWORD=
WA_WORKER_DB_PASSWORD=
# CA do Supabase no host (Database Settings › SSL Configuration).
SUPABASE_CA_FILE=/opt/futuranext/futuranext_portal/certs/supabase-ca.crt
# Conexões por processo. Some com o pool da API do portal e respeite o Pool Size do Supabase.
WA_API_POOL_SIZE=3
WA_WORKER_POOL_SIZE=2

# Redis do serviço (filas de sinalização, QR Code e limites) e da Evolution.
REDIS_PASSWORD=
EVOLUTION_REDIS_PASSWORD=

# TEMPORÁRIO: PostgreSQL local da Evolution (Prisma), até a homologação do schema `evolution`.
POSTGRES_PASSWORD=
EVOLUTION_API_KEY=

# Criptografia de conteúdo e segredos (Fernet, 32 bytes base64 url-safe) e HMAC de chaves/telefones.
# Não troque depois da primeira subida: os dados gravados ficam ilegíveis.
DATA_ENCRYPTION_KEY=
AUTH_PEPPER=

# Igual a FN_WHATSAPP_SERVICE_TOKEN da API do portal (32 caracteres ou mais).
PORTAL_SERVICE_TOKEN=
